<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistem Informasi Kesiswaan SMP (Cloud & Hybrid)</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- html2pdf.js -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- HTML5 QR Code Scanner -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html5-qrcode/2.3.8/html5-qrcode.min.js"></script>
    <!-- Face API for AI Face Recognition -->
    <script defer src="https://vladmandic.github.io/face-api/dist/face-api.js"></script>
    
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body { font-family: 'Inter', sans-serif; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        .custom-scroll::-webkit-scrollbar { height: 6px; width: 6px; }
        .custom-scroll::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 9999px; }
        .swal2-html-container { margin: 1em 0 0.3em !important; overflow-x: hidden; }
        .swal2-popup { width: 95% !important; max-width: 600px; padding: 1.5rem !important; border-radius: 1.5rem !important; }
        
        .swal-grid { display: grid; grid-template-columns: 1fr; gap: 1rem; text-align: left; }
        @media (min-width: 640px) { .swal-grid { grid-template-columns: repeat(2, 1fr); } }
        .swal-full { grid-column: 1 / -1; }
        
        .form-label { display: block; text-align: left; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: #64748b; margin-bottom: 0.25rem; }
        .form-input { width: 100%; padding: 0.625rem 0.875rem; background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 0.75rem; font-size: 0.875rem; outline: none; transition: box-shadow 0.2s; }
        .form-input:focus { border-color: #059669; box-shadow: 0 0 0 2px rgba(5, 150, 105, 0.2); }
        
        @media print {
            body * { visibility: hidden; }
            #printableArea, #printableArea * { visibility: visible; }
            #printableArea { position: absolute; left: 0; top: 0; width: 100%; display: grid; grid-template-columns: repeat(2, 1fr); gap: 15px; }
            .no-print { display: none !important; }
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased overflow-hidden">

    <div id="loadingOverlay" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[100] flex items-center justify-center hidden">
        <div class="bg-white p-6 rounded-2xl shadow-xl flex items-center space-x-4 border border-slate-100">
            <div class="animate-spin rounded-full h-8 w-8 border-3 border-emerald-600 border-t-transparent"></div>
            <span class="font-semibold text-slate-700 text-sm" id="loadingText">Menghubungkan ke Cloud...</span>
        </div>
    </div>

    <div id="loginView" class="min-h-screen flex items-center justify-center bg-gradient-to-br from-emerald-600 via-teal-700 to-slate-900 p-4">
        <div class="bg-white/95 backdrop-blur-md rounded-3xl shadow-2xl w-full max-w-md p-6 sm:p-8 border border-white/20">
            <div class="text-center mb-8">
                <div class="w-16 h-16 bg-emerald-600 text-white rounded-2xl mx-auto flex items-center justify-center text-2xl shadow-lg shadow-emerald-600/30 mb-4"><i class="fa-solid fa-school"></i></div>
                <h1 class="text-2xl font-bold text-slate-900" id="loginSchoolName">S I N I S</h1>
                <p class="text-sm text-slate-500 mt-1">Sistem Informasi Kesiswaan SMP Negeri Terpadu</p>
            </div>
            <form id="loginForm" onsubmit="handleLogin(event)" class="space-y-5">
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-2">ID Pengguna (NIP/NIS/Username)</label>
                    <input type="text" id="loginUsername" required class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none transition text-sm" placeholder="Masukkan ID">
                    <p class="text-[10px] text-slate-400 mt-1">Gunakan akhiran 'OT' setelah NIS untuk login Orang Tua (misal: 1001OT)</p>
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-2">Kata Sandi (Password)</label>
                    <input type="password" id="loginPassword" required class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-none transition text-sm" placeholder="••••••••">
                </div>
                <button type="submit" id="btnLogin" class="w-full py-3.5 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold rounded-xl shadow-lg shadow-emerald-600/30 transition duration-200 text-sm">
                    Masuk Aplikasi
                </button>
                <div class="text-center pt-2">
                    <button type="button" onclick="window.toggleAuthMode('register')" class="text-xs font-semibold text-emerald-700 hover:underline">Belum punya akun? Registrasi Mandiri</button>
                </div>
            </form>

            <form id="registerForm" onsubmit="window.handleRegister(event)" class="space-y-4 hidden">
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Daftar Sebagai</label>
                    <select id="regRole" class="form-input" onchange="window.toggleRegFields(this.value)">
                        <option value="Siswa">Siswa</option>
                        <option value="Guru">Guru / Staf</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1" id="regIdLabel">NIS (Nomor Induk Siswa)</label>
                    <input type="text" id="regId" required class="form-input" placeholder="Masukkan ID / NIS / NIP">
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Nama Lengkap & Gelar</label>
                    <input type="text" id="regName" required class="form-input" placeholder="Nama lengkap...">
                </div>
                <div id="regKelasContainer">
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Kelas</label>
                    <input type="text" id="regKelas" class="form-input" placeholder="Misal: 7-1">
                </div>
                <div id="regTugasContainer" class="hidden">
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Tugas / Jabatan</label>
                    <select id="regTugas" class="form-input">
                        <option value="Guru Mapel">Guru Mapel</option>
                        <option value="Wali Kelas">Wali Kelas</option>
                        <option value="Guru Piket">Guru Piket</option>
                        <option value="Guru BK">Guru BK</option>
                        <option value="Wakabid Kesiswaan">Wakabid Kesiswaan</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Kata Sandi (Password)</label>
                    <input type="password" id="regPassword" required class="form-input" placeholder="••••••••">
                </div>
                <button type="submit" id="btnRegister" class="w-full py-3.5 bg-teal-600 hover:bg-teal-700 text-white font-semibold rounded-xl shadow-lg transition duration-200 text-sm">
                    Daftar Akun Baru
                </button>
                <div class="text-center pt-2">
                    <button type="button" onclick="window.toggleAuthMode('login')" class="text-xs font-semibold text-slate-600 hover:underline">Sudah punya akun? Masuk</button>
                </div>
            </form>
        </div>
    </div>

    <div id="appView" class="h-screen flex hidden relative">
        <div id="sidebarBackdrop" class="fixed inset-0 bg-slate-900/60 z-40 hidden lg:hidden transition-opacity" onclick="window.toggleSidebar()"></div>

        <aside id="sidebar" class="w-64 bg-slate-900 text-slate-300 flex flex-col fixed inset-y-0 left-0 z-50 transform -translate-x-full lg:translate-x-0 lg:static transition-transform duration-300 border-r border-slate-800 shadow-2xl lg:shadow-none">
            <div class="p-6 border-b border-slate-800 flex items-center justify-between">
                <div class="flex items-center space-x-3 overflow-hidden">
                    <div class="w-10 h-10 bg-emerald-600 text-white rounded-xl shrink-0 flex items-center justify-center font-bold shadow-md shadow-emerald-600/20"><i class="fa-solid fa-cloud text-sm"></i></div>
                    <div class="truncate">
                        <h2 class="font-bold text-white text-sm truncate" id="sidebarSchoolName">SIM Kesiswaan</h2>
                        <span class="text-xs text-emerald-400 font-medium" id="sidebarRoleBadge">Role: OPS</span>
                    </div>
                </div>
                <button onclick="window.toggleSidebar()" class="lg:hidden text-slate-400 hover:text-white p-2">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>
            <nav id="sidebarMenu" class="flex-1 px-4 py-4 space-y-1.5 overflow-y-auto custom-scroll"></nav>
            <div class="p-4 border-t border-slate-800">
                <button onclick="handleLogout()" class="w-full flex items-center space-x-3 px-4 py-3 rounded-xl text-rose-400 hover:bg-rose-500/10 transition font-medium text-sm">
                    <i class="fa-solid fa-right-from-bracket w-5"></i><span>Keluar Sistem</span>
                </button>
            </div>
        </aside>

        <div class="flex-1 flex flex-col min-w-0 bg-slate-50 h-screen overflow-hidden">
            <header class="bg-white border-b border-slate-200 h-16 sm:h-20 flex shrink-0 items-center justify-between px-4 sm:px-8 z-30 shadow-xs">
                <div class="flex items-center space-x-4">
                    <button onclick="window.toggleSidebar()" class="text-slate-500 hover:text-emerald-600 transition p-2 -ml-2 lg:hidden">
                        <i class="fa-solid fa-bars text-xl"></i>
                    </button>
                    <h1 id="pageTitle" class="text-lg sm:text-xl font-bold text-slate-800 truncate">Dashboard</h1>
                </div>
                <div class="flex items-center space-x-4 shrink-0">
                    <div class="text-right hidden sm:block">
                        <p class="text-sm font-bold text-slate-800 truncate max-w-[150px]" id="currentUserName">Administrator</p>
                        <p class="text-xs text-slate-500 font-medium truncate max-w-[150px]" id="currentUserRole">Operator Sistem</p>
                    </div>
                    <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-2xl bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold shadow-sm shrink-0"><i class="fa-solid fa-user-shield"></i></div>
                </div>
            </header>
            <main id="mainContent" class="flex-1 p-4 sm:p-6 lg:p-8 overflow-y-auto custom-scroll w-full"></main>
        </div>
    </div>

    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, collection, getDocs, setDoc, doc, deleteDoc } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        const firebaseConfig = {
          apiKey: "AIzaSyBm9oLwj4aYaD5RTNTAnaOZzg2qmddoEIw",
          authDomain: "kesiswaan-24.firebaseapp.com",
          projectId: "kesiswaan-24",
          storageBucket: "kesiswaan-24.firebasestorage.app",
          messagingSenderId: "760886773941",
          appId: "1:760886773941:web:9b6a03f2c7c353a80896fc",
          measurementId: "G-F4H2TEXXF9"
        };

        window.appId = 'default-smp-cloud-app';
        window.GAS_URL = "https://script.google.com/macros/s/AKfycbxzp_DftyLvf-ikAEh7T61gzmFaSFi8QwjcMqLCCl3PFcNVvB-omtFoI7e3Zm6QCb-s/exec"; 

        const app = initializeApp(firebaseConfig);
        const db = getFirestore(app);
        const auth = getAuth(app);

        window.currentUser = null;
        window.appData = {
            schoolProfile: { nama: "SMP Negeri Terpadu", npsn: "12345678", alamat: "Jl. Pendidikan No. 1", telepon: "021-555123", modeAbsenAktif: 'Masuk', logo: '' },
            permissions: [], classes: [], students: [], teachers: [], violations: [], attendance: [], messages: [], tataTertib: []
        };

        const stdRoles = ['Admin', 'Wakabid Kesiswaan', 'Admin/TU', 'Wali Kelas', 'Guru BK', 'Guru Piket', 'Siswa', 'Orang Tua'];
        
        window.activeDataMasterTab = 'profil';
        window.currentPage = 'dashboard';
        window.cardSettings = { bgTheme: 'bg-white border border-slate-300', opacity: '1', font: 'Inter', size: 'text-xs', textColor: 'text-slate-800', accent: 'text-emerald-700', filterKelas: 'ALL', customColor: '#059669', customFontSize: '12' };

        const menus = [
            { id: 'dashboard', label: 'Dashboard Utama', icon: 'fa-chart-pie' },
            { id: 'datamaster', label: 'Data Master', icon: 'fa-database' },
            { id: 'tatatertibsekolah', label: 'Tata Tertib Sekolah', icon: 'fa-book-bookmark' },
            { id: 'absensi', label: 'Presensi & RFID', icon: 'fa-fingerprint' },
            { id: 'pelanggaran', label: 'Pelanggaran', icon: 'fa-triangle-exclamation' },
            { id: 'kartupelajar', label: 'Kartu Pelajar', icon: 'fa-id-card' },
            { id: 'pengaturan', label: 'Hak Akses Menu', icon: 'fa-gear' },
            { id: 'rekapabsensi', label: 'Rekap Presensi', icon: 'fa-calendar-days' },
            { id: 'rekappelanggaran', label: 'Rekap Pelanggaran', icon: 'fa-clipboard-list' },
            { id: 'pesan', label: 'Pesan & Surat', icon: 'fa-envelope' },
            { id: 'backuprestore', label: 'Backup & Restore', icon: 'fa-server', opsOnly: true }
        ];

        window.toggleSidebar = function() {
            const sidebar = document.getElementById('sidebar');
            const backdrop = document.getElementById('sidebarBackdrop');
            if (sidebar.classList.contains('-translate-x-full')) {
                sidebar.classList.remove('-translate-x-full');
                backdrop.classList.remove('hidden');
            } else {
                sidebar.classList.add('-translate-x-full');
                backdrop.classList.add('hidden');
            }
        };

        async function initAuthAndLoad() {
            try {
                await signInAnonymously(auth);
            } catch (e) {
                console.warn("Offline fallback mode active");
            }

            const savedSession = localStorage.getItem('simKesiswaanSession');
            if (savedSession) {
                window.currentUser = JSON.parse(savedSession);
                document.getElementById('loginView').classList.add('hidden');
                document.getElementById('appView').classList.remove('hidden');
                
                window.showLoading(true, 'Memuat Database...');
                await window.fetchCloudData();
                window.showLoading(false);
                
                if(window.currentUser) {
                    updateUIProfile();
                    window.buildSidebar();
                    window.navigateTo(window.currentPage);
                }
            }
        }

        window.onload = function() { initAuthAndLoad(); };

        window.showLoading = function(show, text = 'Memproses data cloud...') {
            const el = document.getElementById('loadingOverlay');
            const textEl = document.getElementById('loadingText');
            if (textEl) textEl.innerText = text;
            if (show) el.classList.remove('hidden'); else el.classList.add('hidden');
        };

        function updateUIProfile() {
            if (!window.currentUser) return;
            const badge = document.getElementById('sidebarRoleBadge');
            if (badge) badge.innerText = 'Role: ' + window.currentUser.role;
            const uName = document.getElementById('currentUserName');
            if (uName) uName.innerText = window.currentUser.name;
            const uRole = document.getElementById('currentUserRole');
            if (uRole) uRole.innerText = window.currentUser.role;
            
            if(window.appData && window.appData.schoolProfile && window.appData.schoolProfile.nama) {
                const sName = document.getElementById('sidebarSchoolName');
                if (sName) sName.innerText = window.appData.schoolProfile.nama;
                const lName = document.getElementById('loginSchoolName');
                if (lName) lName.innerText = window.appData.schoolProfile.nama;
            }
        }

        window.handleLogin = async function(e) {
            e.preventDefault();
            const btn = document.getElementById('btnLogin');
            const user = document.getElementById('loginUsername').value.trim();
            const pass = document.getElementById('loginPassword').value.trim();

            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Memverifikasi...';
            window.showLoading(true, 'Autentikasi Cloud...');

            await window.fetchCloudData();

            let authValid = false;
            let userInfo = null;

            if (user === 'ops' && pass === '123456') {
                authValid = true; userInfo = { role: 'OPS', identifier: 'ops', name: 'Operator Sistem' };
            } else {
                let checkUser = user;
                let isParent = false;
                
                if (user.toUpperCase().endsWith('OT')) {
                    isParent = true;
                    checkUser = user.substring(0, user.length - 2);
                }

                const foundSiswa = window.appData.students.find(s => String(s.nis) === checkUser && (String(s.nis) === pass || String(s.nisn) === pass || String(s.password) === pass));
                if (foundSiswa) {
                    authValid = true; 
                    if (isParent) {
                        userInfo = { role: 'Orang Tua', identifier: foundSiswa.nis, name: 'Ortu: ' + foundSiswa.nama };
                    } else {
                        userInfo = { role: 'Siswa', identifier: foundSiswa.nis, name: foundSiswa.nama };
                    }
                } else {
                    const foundGuru = window.appData.teachers.find(t => String(t.nip) === user && (String(t.nip) === pass || String(t.password) === pass));
                    if (foundGuru) {
                        let assignedRole = foundGuru.tugas || 'Guru';
                        if (!stdRoles.includes(assignedRole) && assignedRole !== 'Admin') assignedRole = 'Admin/TU';
                        authValid = true; 
                        userInfo = { role: assignedRole, identifier: foundGuru.nip, name: foundGuru.nama };
                    }
                }
            }

            btn.innerHTML = 'Masuk Aplikasi';
            window.showLoading(false);

            if (authValid) {
                window.currentUser = userInfo;
                localStorage.setItem('simKesiswaanSession', JSON.stringify(window.currentUser));
                document.getElementById('loginView').classList.add('hidden');
                document.getElementById('appView').classList.remove('hidden');
                updateUIProfile();
                window.buildSidebar();
                window.navigateTo('dashboard');
            } else {
                Swal.fire('Gagal Masuk', 'ID atau Password salah!', 'error');
            }
        };

        window.toggleAuthMode = function(mode) {
            const loginForm = document.getElementById('loginForm');
            const registerForm = document.getElementById('registerForm');
            if (mode === 'register') {
                loginForm.classList.add('hidden');
                registerForm.classList.remove('hidden');
            } else {
                registerForm.classList.add('hidden');
                loginForm.classList.remove('hidden');
            }
        };

        window.toggleRegFields = function(role) {
            const clsC = document.getElementById('regKelasContainer');
            const tgsC = document.getElementById('regTugasContainer');
            const lbl = document.getElementById('regIdLabel');
            if (role === 'Siswa') {
                clsC.classList.remove('hidden');
                tgsC.classList.add('hidden');
                lbl.innerText = 'NIS (Nomor Induk Siswa)';
            } else {
                clsC.classList.add('hidden');
                tgsC.classList.remove('hidden');
                lbl.innerText = 'NIP / ID Guru';
            }
        };

        window.handleRegister = async function(e) {
            e.preventDefault();
            const role = document.getElementById('regRole').value;
            const id = document.getElementById('regId').value.trim();
            const name = document.getElementById('regName').value.trim();
            const pass = document.getElementById('regPassword').value.trim();

            if (!id || !name || !pass) return Swal.fire('Error', 'Semua kolom wajib diisi!', 'error');

            window.showLoading(true, 'Mendaftarkan akun...');
            try {
                if (role === 'Siswa') {
                    const kelas = document.getElementById('regKelas').value.trim() || '7-1';
                    const newS = { nis: id, nisn: id, nama: name, kelas: kelas, jk: 'L', agama: 'Islam', alamat: '', tahunMasuk: new Date().getFullYear(), foto: '', password: pass };
                    window.appData.students.push(newS);
                    await window.saveToFirebase('students', id, newS);
                } else {
                    const tugas = document.getElementById('regTugas').value;
                    const newT = { nip: id, nama: name, tugas: tugas, telepon: '', email: '', password: pass, kelasWali: '' };
                    window.appData.teachers.push(newT);
                    await window.saveToFirebase('teachers', id, newT);
                }
                window.showLoading(false);
                Swal.fire('Registrasi Berhasil', 'Akun berhasil dibuat! Silakan masuk.', 'success');
                window.toggleAuthMode('login');
                document.getElementById('registerForm').reset();
            } catch(err) {
                window.showLoading(false);
                Swal.fire('Gagal', err.message, 'error');
            }
        };

        window.handleLogout = function() {
            window.currentUser = null;
            localStorage.removeItem('simKesiswaanSession');
            document.getElementById('appView').classList.add('hidden');
            document.getElementById('loginView').classList.remove('hidden');
            document.getElementById('loginForm').reset();
        };

        window.fetchCloudData = async function() {
            try {
                const basePathStr = `artifacts/${window.appId}/public/data`;
                const collectionsToFetch = ['schoolProfile', 'permissions', 'classes', 'students', 'teachers', 'tataTertib', 'violations', 'attendance', 'messages'];
                const promises = collectionsToFetch.map(col => getDocs(collection(db, `${basePathStr}/${col}`)));
                const snaps = await Promise.all(promises);

                if (!snaps[0].empty) {
                    window.appData.schoolProfile = snaps[0].docs[0].data();
                    if(!window.appData.schoolProfile.modeAbsenAktif) window.appData.schoolProfile.modeAbsenAktif = 'Masuk';
                }
                
                window.appData.permissions = snaps[1].docs.map(d => d.data());
                stdRoles.forEach(r => {
                    if(!window.appData.permissions.find(p => p.role === r)) {
                        window.appData.permissions.push({ role: r, dashboard: true, datamaster: false, tatatertibsekolah: true, absensi: false, pelanggaran: false, kartupelajar: false, pengaturan: false, rekapabsensi: false, rekappelanggaran: false, pesan: true });
                    }
                });

                window.appData.classes = snaps[2].docs.map(d => d.data());
                window.appData.students = snaps[3].docs.map(d => d.data());
                window.appData.teachers = snaps[4].docs.map(d => d.data());
                window.appData.tataTertib = snaps[5].docs.map(d => d.data());
                window.appData.violations = snaps[6].docs.map(d => d.data());
                window.appData.attendance = snaps[7].docs.map(d => d.data());
                window.appData.messages = snaps[8].docs.map(d => d.data());

                localStorage.setItem('simKesiswaanCache', JSON.stringify(window.appData));
            } catch (err) {
                const cached = localStorage.getItem('simKesiswaanCache');
                if (cached) window.appData = JSON.parse(cached);
            }
            if (window.currentUser) updateUIProfile();
        };

        window.saveToFirebase = async function(collectionName, docId, dataObj) {
            try {
                const basePathStr = `artifacts/${window.appId}/public/data/${collectionName}`;
                await setDoc(doc(db, basePathStr, docId), dataObj);
                
                if ((collectionName === 'attendance' || collectionName === 'violations') && window.GAS_URL && window.GAS_URL.startsWith('http')) {
                    fetch(window.GAS_URL, {
                        method: 'POST',
                        mode: 'no-cors',
                        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                        body: JSON.stringify({ action: 'update', sheetName: collectionName, payload: dataObj, id: docId })
                    }).catch(e => console.warn('Sync to Sheet Error:', e));
                }
            } catch(e) { console.error("Firebase Error:", e); }
            localStorage.setItem('simKesiswaanCache', JSON.stringify(window.appData));
        };
        
        window.deleteFromFirebase = async function(collectionName, docId) {
            try {
                const basePathStr = `artifacts/${window.appId}/public/data/${collectionName}`;
                await deleteDoc(doc(db, basePathStr, docId));
                
                if ((collectionName === 'attendance' || collectionName === 'violations') && window.GAS_URL && window.GAS_URL.startsWith('http')) {
                    fetch(window.GAS_URL, {
                        method: 'POST',
                        mode: 'no-cors',
                        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                        body: JSON.stringify({ action: 'delete', sheetName: collectionName, id: docId })
                    }).catch(e => console.warn('Sync to Sheet Error:', e));
                }
            } catch(e) { console.error("Firebase Error:", e); }
            localStorage.setItem('simKesiswaanCache', JSON.stringify(window.appData));
        };

