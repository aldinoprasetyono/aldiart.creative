            if (checked.length === 0) return Swal.fire('Info', 'Tidak ada data yang dipilih', 'info');
            Swal.fire({
                title: `Hapus ${checked.length} data terpilih?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#e11d48',
                confirmButtonText: 'Ya, Hapus Semua'
            }).then(async (res) => {
                if (res.isConfirmed) {
                    window.showLoading(true, 'Menghapus data...');
                    for (const id of checked) {
                        if (collectionName === 'students') {
                            window.appData.students = window.appData.students.filter(x => String(x.nis) !== String(id));
                        } else if (collectionName === 'teachers') {
                            window.appData.teachers = window.appData.teachers.filter(x => String(x.nip) !== String(id));
                        } else if (collectionName === 'classes') {
                            window.appData.classes = window.appData.classes.filter(x => x.id !== id);
                        } else if (collectionName === 'tataTertib') {
                            window.appData.tataTertib = window.appData.tataTertib.filter(x => x.id !== id);
                        } else if (collectionName === 'attendance') {
                            window.appData.attendance = window.appData.attendance.filter(x => x.id !== id);
                        } else if (collectionName === 'violations') {
                            window.appData.violations = window.appData.violations.filter(x => x.id !== id);
                        }
