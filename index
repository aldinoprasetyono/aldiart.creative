            if(isRestricted) {
                data = data.filter(a => String(a.nis) === String(window.currentUser.identifier));
            } else {
                const fk = document.getElementById('fKelas')?.value || 'ALL';
                const fs = document.getElementById('fSiswa')?.value || 'ALL';
                const fm = document.getElementById('fMulai')?.value;
                const fa = document.getElementById('fAkhir')?.value;
                const ft = document.getElementById('fStatus')?.value || 'ALL';

                data = data.filter(a => {
                    let pass = true;
                    if(fk !== 'ALL' && fk !== '' && a.kelas !== fk) pass = false;
                    if(fs !== 'ALL' && String(a.nis) !== String(fs)) pass = false;
                    if(ft !== 'ALL' && !String(a.status).includes(ft)) pass = false;
                    if(fm && a.tanggalOnly < fm) pass = false;
                    if(fa && a.tanggalOnly > fa) pass = false;
                    return pass;
