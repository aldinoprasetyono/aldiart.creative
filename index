        window.submitAbsensi = async function(nis, status) {
            if (!window.scanLocks) window.scanLocks = {};
            const now = Date.now();
            if (window.scanLocks[nis] && (now - window.scanLocks[nis] < 4000)) return;
            window.scanLocks[nis] = now;

            const student = window.appData.students.find(s => String(s.nis) === String(nis));
            if(!student) {
                window.speakNotification('Siswa tidak ditemukan.');
                return Swal.fire({ toast: true, position: 'top-end', icon: 'error', title: 'NIS Tidak Valid!', showConfirmButton: false, timer: 2000 });
            }
            
            const curMode = window.appData.schoolProfile.modeAbsenAktif || 'Masuk';
            const curDate = new Date().toISOString().split('T')[0];
            const firstName = student.nama.split(' ')[0];
            
            const exists = window.appData.attendance.find(a => String(a.nis) === String(student.nis) && a.tanggalOnly === curDate && a.mode === curMode);
            
            if(exists) {
                window.speakNotification(`${firstName}, sudah absen ${curMode}.`);
                return Swal.fire({ toast: true, position: 'top-end', icon: 'info', title: 'Sudah Tercatat!', text: `${student.nama} sudah absen ${curMode} hari ini.`, showConfirmButton: false, timer: 2500 });
            }

            const record = { 
                id: 'ATT_' + Date.now() + Math.floor(Math.random()*100), 
                waktu: new Date().toLocaleString('id-ID'), 
                tanggalOnly: curDate, 
                nis: student.nis, 
                nama: student.nama, 
                kelas: student.kelas, 
                status: status,
                mode: curMode 
            };
            
            window.appData.attendance.push(record);
            await window.saveToFirebase('attendance', record.id, record);
            
            window.speakNotification(`Terima kasih, ${firstName}.`);
            Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: `Berhasil (${curMode})`, text: student.nama, showConfirmButton: false, timer: 2000 });
            
            if(document.getElementById('rfidInput')) document.getElementById('rfidInput').value = '';
        };

        window.generateAlphaToday = async function() {
            const curDate = new Date().toISOString().split('T')[0];
            const absenHariIni = window.appData.attendance.filter(a => a.tanggalOnly === curDate).map(a => String(a.nis));
            const belumAbsen = window.appData.students.filter(s => !absenHariIni.includes(String(s.nis)));
            
            if(belumAbsen.length === 0) return Swal.fire('Info', 'Semua siswa sudah tercatat kehadirannya hari ini.', 'info');
            
            const res = await Swal.fire({
                title: 'Generate Alpha Massal?',
                text: `Ditemukan ${belumAbsen.length} siswa yang belum absen hari ini. Tandai Alpha?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#e11d48',
                confirmButtonText: 'Ya, Tandai Alpha'
            });
            
            if(res.isConfirmed) {
                window.showLoading(true, 'Memproses Alpha Massal...');
                let c = 0;
                for (const student of belumAbsen) {
                    const record = { 
                        id: 'ATT_ALPHA_' + Date.now() + c, 
                        waktu: curDate + ' ' + new Date().toLocaleTimeString('id-ID'), 
                        tanggalOnly: curDate, 
                        nis: student.nis, 
                        nama: student.nama, 
                        kelas: student.kelas, 
                        status: 'Tanpa Keterangan',
                        mode: 'Alpha System'
                    };
                    window.appData.attendance.push(record);
                    await window.saveToFirebase('attendance', record.id, record);
                    c++;
                }
                window.showLoading(false);
                window.applyFilterAbsen();
                Swal.fire('Selesai', `${c} siswa berhasil ditandai Alpha.`, 'success');
            }
        };

