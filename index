        window.deleteVio = async function(id) {
            const res = await Swal.fire({ title: 'Hapus Pelanggaran?', icon: 'warning', showCancelButton: true, confirmButtonColor: '#e11d48', confirmButtonText: 'Ya, Hapus' });
            if(res.isConfirmed) {
                window.appData.violations = window.appData.violations.filter(x => x.id !== id);
                await window.deleteFromFirebase('violations', id);
                window.applyFilterPelanggaran();
                Swal.fire({title: 'Terhapus', icon: 'success', timer: 1000, showConfirmButton: false});
            }
        };

        window.editVio = async function(id) {
            const v = window.appData.violations.find(x => x.id === id);
            if(!v) return;
            let ruleOpts = window.appData.tataTertib.map(t => `<option value="${t.jenis}" data-poin="${t.poin}" ${v.jenis===t.jenis?'selected':''}>${t.jenis} (${t.poin} Poin)</option>`).join('');
            const { value: val } = await Swal.fire({
                title: 'Edit Pelanggaran',
                html: `<div class="swal-grid"><div class="swal-full"><label class="form-label">Jenis</label><select id="ev-jenis" class="form-input" onchange="document.getElementById('ev-poin').value=this.options[this.selectedIndex].getAttribute('data-poin')">${ruleOpts}</select></div><div><label class="form-label">Poin</label><input id="ev-poin" class="form-input font-bold text-rose-600" value="${v.poin}" readonly></div></div>`,
                focusConfirm: false, showCancelButton: true, confirmButtonText: 'Simpan',
                preConfirm: () => ({ jenis: document.getElementById('ev-jenis').value, poin: parseInt(document.getElementById('ev-poin').value) })
            });
            if(val) {
                v.jenis = val.jenis;
                v.poin = val.poin;
                await window.saveToFirebase('violations', id, v);
                window.applyFilterPelanggaran();
            }
        };

