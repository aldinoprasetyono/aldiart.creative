        function renderPesan(container) {
            const isStudent = ['Siswa', 'Orang Tua'].includes(window.currentUser.role);
            let classOpts = window.appData.classes.map(c => `<option value="${c.nama}">${c.nama}</option>`).join('');
            let studentOpts = window.appData.students.map(s => `<option value="${s.nis}" data-kelas="${s.kelas}">${s.nama} (${s.kelas})</option>`).join('');

            container.innerHTML = `
                <div class="bg-white rounded-3xl shadow-sm border p-6 space-y-6 max-w-3xl mx-auto">
                    <div class="flex items-center space-x-3 border-b pb-4">
                        <div class="w-12 h-12 bg-emerald-100 text-emerald-600 rounded-xl flex items-center justify-center font-bold text-xl"><i class="fa-solid fa-envelope"></i></div>
                        <div><h3 class="text-xl font-bold">Pesan & Surat Keterangan</h3><p class="text-xs text-slate-500">${isStudent ? 'Kirim surat izin/sakit langsung ke wali kelas.' : 'Kotak masuk surat dan pesan.'}</p></div>
                    </div>
                    <form onsubmit="window.submitPesan(event)" class="space-y-4">
                        ${isStudent ? `
                            <div class="p-4 bg-blue-50 text-blue-800 rounded-2xl text-xs font-semibold">
                                <i class="fa-solid fa-info-circle mr-1"></i> Pesan Anda akan dikirimkan kepada Wali Kelas Anda.
                            </div>
                        ` : `
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div><label class="form-label">Filter Kelas Tujuan</label><select id="msgKelasFilter" onchange="window.filterMsgStudents(this.value)" class="form-input"><option value="ALL">Semua Kelas</option>${classOpts}</select></div>
                                <div><label class="form-label">Pilih Siswa / Penerima</label><select id="msgSiswa" class="form-input"><option value="">-- Pilih Siswa --</option>${studentOpts}</select></div>
                            </div>
                        `}
                        <div><label class="form-label">Subjek / Perihal</label><input type="text" id="msgSubjek" required class="form-input" placeholder="Misal: Surat Izin Tidak Masuk Sekolah"></div>
                        <div><label class="form-label">Isi Pesan / Keterangan</label><textarea id="msgIsi" required rows="4" class="form-input" placeholder="Tuliskan alasan atau pesan..."></textarea></div>
                        <div><label class="form-label">Lampiran Surat (JPG/PDF, Maks 500KB)</label><input type="file" id="msgFile" accept=".jpg,.jpeg,.png,.pdf" class="form-input p-2 text-xs"></div>
                        <button type="submit" class="w-full py-3.5 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold rounded-xl shadow-lg transition text-sm">Kirim Pesan / Surat</button>
                    </form>
                </div>
            `;
        }

        window.filterMsgStudents = function(kelasName) {
            const sel = document.getElementById('msgSiswa');
            if(!sel) return;
            let list = window.appData.students;
            if(kelasName !== 'ALL') list = list.filter(s => s.kelas === kelasName);
            sel.innerHTML = '<option value="">-- Pilih Siswa --</option>' + list.map(s => `<option value="${s.nis}">${s.nama} (${s.kelas})</option>`).join('');
        };

        window.submitPesan = async function(e) {
            e.preventDefault();
            const subjek = document.getElementById('msgSubjek').value;
            const isi = document.getElementById('msgIsi').value;
            const fileInput = document.getElementById('msgFile');
            
            let fileB64 = '';
            if (fileInput && fileInput.files.length > 0) {
                const file = fileInput.files[0];
                if (file.size > 500 * 1024) return Swal.fire('Error', 'Ukuran file lampiran maksimal 500KB', 'error');
                fileB64 = await new Promise(r => { const reader = new FileReader(); reader.onload = () => r(reader.result); reader.readAsDataURL(file); });
            }

            const record = {
                id: 'MSG_' + Date.now(),
                tanggal: new Date().toLocaleString('id-ID'),
                pengirim: window.currentUser.name,
                rolePengirim: window.currentUser.role,
                subjek: subjek,
                isi: isi,
                lampiran: fileB64
            };

            window.showLoading(true, 'Mengirim pesan...');
            window.appData.messages.push(record);
            await window.saveToFirebase('messages', record.id, record);
            window.showLoading(false);

            Swal.fire('Berhasil', 'Pesan dan surat berhasil dikirim.', 'success');
            e.target.reset();
        };

        function renderBackupRestore(container) {
            container.innerHTML = `
                <div class="bg-white rounded-3xl shadow-sm border p-6 space-y-6 max-w-2xl mx-auto">
                    <div class="flex items-center space-x-3 border-b pb-4">
                        <div class="w-12 h-12 bg-indigo-100 text-indigo-600 rounded-xl flex items-center justify-center font-bold text-xl"><i class="fa-solid fa-server"></i></div>
                        <div><h3 class="text-xl font-bold">Backup & Restore Data</h3><p class="text-xs text-slate-500">Unduh cadangan seluruh data sistem atau pulihkan dari file.</p></div>
                    </div>
                    <div class="space-y-4">
                        <div class="p-4 bg-slate-50 rounded-2xl border flex justify-between items-center">
                            <div><h4 class="font-bold text-sm">Unduh Cadangan (.json)</h4><p class="text-xs text-slate-500">Simpan salinan database lokal ke perangkat Anda.</p></div>
                            <button onclick="window.downloadBackup()" class="px-4 py-2.5 bg-emerald-600 text-white rounded-xl text-xs font-bold shadow hover:bg-emerald-700 transition"><i class="fa-solid fa-download mr-1"></i>Download</button>
                        </div>
                        <div class="p-4 bg-slate-50 rounded-2xl border space-y-3">
                            <div><h4 class="font-bold text-sm">Pulihkan Data (Restore)</h4><p class="text-xs text-slate-500">Pilih file .json cadangan untuk mengembalikan database.</p></div>
                            <input type="file" id="restoreFile" accept=".json" class="form-input p-2 text-xs">
                            <button onclick="window.processRestore()" class="w-full py-2.5 bg-blue-600 text-white rounded-xl text-xs font-bold shadow hover:bg-blue-700 transition"><i class="fa-solid fa-upload mr-1"></i>Unggah & Pulihkan</button>
                        </div>
                    </div>
                </div>
            `;
        }

        window.downloadBackup = function() {
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(window.appData, null, 2));
            const dlAnchor = document.createElement('a');
            dlAnchor.setAttribute("href", dataStr);
            dlAnchor.setAttribute("download", `Backup_SIM_Kesiswaan_${new Date().toISOString().split('T')[0]}.json`);
            document.body.appendChild(dlAnchor);
            dlAnchor.click();
            dlAnchor.remove();
        };

        window.processRestore = function() {
            const fileInput = document.getElementById('restoreFile');
            if(!fileInput || fileInput.files.length === 0) return Swal.fire('Error', 'Pilih file backup terlebih dahulu.', 'error');
            const file = fileInput.files[0];
            const reader = new FileReader();
            reader.onload = async function(e) {
                try {
                    const parsed = JSON.parse(e.target.result);
                    window.showLoading(true, 'Memulihkan data ke Cloud...');
                    window.appData = parsed;
                    localStorage.setItem('simKesiswaanCache', JSON.stringify(window.appData));
                    
                    for(const s of (window.appData.students||[])) { await window.saveToFirebase('students', s.nis, s); }
                    for(const t of (window.appData.teachers||[])) { await window.saveToFirebase('teachers', t.nip, t); }
                    for(const c of (window.appData.classes||[])) { await window.saveToFirebase('classes', c.id, c); }
                    for(const tt of (window.appData.tataTertib||[])) { await window.saveToFirebase('tataTertib', tt.id, tt); }
                    
                    window.showLoading(false);
                    Swal.fire('Sukses', 'Data berhasil dipulihkan seluruhnya!', 'success');
                    window.navigateTo('dashboard');
                } catch(err) {
                    window.showLoading(false);
                    Swal.fire('Gagal', 'Format file backup tidak valid: ' + err.message, 'error');
                }
            };
            reader.readAsText(file);
        };

        function renderPengaturan(container) {
            if (window.currentUser.role !== 'OPS' && window.currentUser.role !== 'Admin') {
                container.innerHTML = `<div class="bg-white rounded-3xl shadow-sm border p-8 text-center"><div class="w-16 h-16 bg-rose-100 text-rose-600 rounded-2xl mx-auto flex items-center justify-center text-2xl mb-4"><i class="fa-solid fa-lock"></i></div><h3 class="text-xl font-bold text-slate-800 mb-2">Akses Ditolak</h3><p class="text-sm text-slate-500">Hanya Administrator sistem yang memiliki wewenang untuk mengubah hak akses menu.</p></div>`;
                return;
            }

            const menuList = [
                { id: 'datamaster', label: 'Data Master' }, { id: 'absensi', label: 'Presensi / Scan' },
                { id: 'pelanggaran', label: 'Pelanggaran' }, { id: 'kartupelajar', label: 'Kartu Pelajar' },
                { id: 'tatatertibsekolah', label: 'Tata Tertib' },
                { id: 'pengaturan', label: 'Hak Akses' }, { id: 'rekapabsensi', label: 'Rekap Presensi' },
                { id: 'rekappelanggaran', label: 'Rekap Kasus' }, { id: 'pesan', label: 'Surat & Pesan' }
            ];

            let html = `
                <div class="bg-white rounded-3xl shadow-sm border p-6 space-y-6">
                    <div class="flex justify-between items-center border-b pb-4"><h3 class="text-xl font-bold">Konfigurasi Hak Akses Role (Peran)</h3><p class="text-xs text-slate-500 hidden sm:block">Perubahan akan langsung aktif secara otomatis.</p></div>
                    <div class="overflow-x-auto custom-scroll pb-4">
                        <table class="w-full text-left text-sm whitespace-nowrap">
                            <thead class="bg-slate-100">
                                <tr>
                                    <th class="p-3 sticky left-0 bg-slate-100 z-10 border-r border-white">Peran / Role Pengguna</th>
                                    ${menuList.map(m => `<th class="p-3 text-center text-xs uppercase tracking-wider">${m.label}</th>`).join('')}
                                </tr>
                            </thead>
                            <tbody class="divide-y">
            `;

            stdRoles.forEach(role => {
                if (role === 'OPS') return;
                const perms = getRolePermissions(role);
                html += `<tr class="hover:bg-slate-50 transition"><td class="p-3 font-bold text-slate-700 sticky left-0 bg-white z-10 border-r border-slate-100">${role}</td>`;
                menuList.forEach(m => {
                    const isChecked = perms[m.id] === true || perms[m.id] === 'true' || perms[m.id] === 'TRUE' ? 'checked' : '';
                    html += `<td class="p-3 text-center"><input type="checkbox" onchange="window.updatePermission('${role}', '${m.id}', this.checked)" class="w-5 h-5 accent-emerald-600 rounded cursor-pointer transition-transform hover:scale-110" ${isChecked}></td>`;
                });
                html += `</tr>`;
            });

            html += `</tbody></table></div></div>`;
            container.innerHTML = html;
        }

        window.updatePermission = async function(role, menuId, isGranted) {
            let perm = window.appData.permissions.find(p => p.role === role);
            if (!perm) {
                perm = { role: role, dashboard: true };
                window.appData.permissions.push(perm);
            }
            perm[menuId] = isGranted;
            await window.saveToFirebase('permissions', role.replace(/\s+/g, ''), perm); 
            window.buildSidebar();
        };
    </script>
</body>
