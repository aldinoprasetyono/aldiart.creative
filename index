        window.toggleCameraFace = async function() {
            const btn = document.getElementById('btnToggleFace');
            const video = document.getElementById('faceVideo');
            const statusText = document.getElementById('camStatusText');

            if (window.isCameraScanningFace) {
                if(window.aiInterval) clearInterval(window.aiInterval);
                if(window.aiStream) window.aiStream.getTracks().forEach(t => t.stop());
                video.classList.add('hidden');
                statusText.innerText = "Kamera Mati";
                btn.innerHTML = '<i class="fa-solid fa-face-smile-scan mr-2"></i>AI Wajah';
                window.isCameraScanningFace = false;
            } else {
                statusText.innerText = "Memuat AI Wajah... (Pastikan wajah menghadap cahaya)";
                try {
                    if (!window.faceApiLoaded) {
                        await faceapi.nets.tinyFaceDetector.loadFromUri('https://vladmandic.github.io/face-api/model/');
                        await faceapi.nets.faceLandmark68Net.loadFromUri('https://vladmandic.github.io/face-api/model/');
                        await faceapi.nets.faceRecognitionNet.loadFromUri('https://vladmandic.github.io/face-api/model/');
                        window.faceApiLoaded = true;
                    }
                    window.aiStream = await navigator.mediaDevices.getUserMedia({ 
                        video: { facingMode: 'user', width: { ideal: 640 }, height: { ideal: 480 } } 
                    });
                    video.srcObject = window.aiStream;
                    video.classList.remove('hidden');
                    statusText.innerText = "";
                    window.isCameraScanningFace = true;
                    btn.innerHTML = '<i class="fa-solid fa-stop mr-2"></i>Matikan AI';

                    const enrolled = window.appData.students.filter(s => s.faceData && s.faceData.length > 0);
                    if (enrolled.length === 0) return Swal.fire('Info', 'Belum ada data wajah siswa di Data Master.', 'info');
                    
                    const matchers = new faceapi.FaceMatcher(enrolled.map(s => new faceapi.LabeledFaceDescriptors(s.nis, [new Float32Array(s.faceData)])), 0.45);

                    window.aiInterval = setInterval(async () => {
                        const det = await faceapi.detectSingleFace(video, new faceapi.TinyFaceDetectorOptions()).withFaceLandmarks().withFaceDescriptor();
                        if (det) {
                            const res = matchers.findBestMatch(det.descriptor);
                            if (res.label !== "unknown" && res.distance < 0.45) {
                                if(window.isScanningCooldown) return;
                                window.isScanningCooldown = true;
                                setTimeout(() => window.isScanningCooldown = false, 2500);
                                window.submitAbsensi(res.label, 'Hadir');
                            }
                        }
                    }, 1000);
                } catch(e) { Swal.fire('Error AI', "Gagal membuka kamera: " + e.message, 'error'); }
            }
        };

