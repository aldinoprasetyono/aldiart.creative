            const perms = getRolePermissions(window.currentUser.role);

            menus.forEach(m => {
                if (m.opsOnly && window.currentUser.role !== 'OPS') return;
                const access = perms[m.id] === true || perms[m.id] === 'TRUE' || perms[m.id] === 'true' || m.id === 'dashboard' || m.id === 'pesan';
                
                if (window.currentUser.role === 'OPS' || access) {
                    const a = document.createElement('a');
                    a.href = '#';
                    a.onclick = (e) => { 
                        e.preventDefault(); 
                        window.navigateTo(m.id);
                        if (window.innerWidth < 1024) window.toggleSidebar(); 
                    };
                    a.id = 'menu-' + m.id;
                    a.className = "flex items-center space-x-3 px-4 py-3 rounded-xl text-slate-300 hover:bg-emerald-600/20 hover:text-white transition font-medium text-sm";
                    a.innerHTML = `<i class="fa-solid ${m.icon} w-5 text-emerald-400"></i><span class="truncate">${m.label}</span>`;
