            if (role === 'OPS') return { dashboard:true, datamaster:true, tatatertibsekolah:true, absensi:true, pelanggaran:true, kartupelajar:true, pengaturan:true, rekapabsensi:true, rekappelanggaran:true, pesan:true, backuprestore:true };
            const perm = window.appData.permissions.find(p => String(p.role).trim().toLowerCase() === String(role).trim().toLowerCase());
            return perm || { dashboard:true, tatatertibsekolah:true, pesan:true };
        }

